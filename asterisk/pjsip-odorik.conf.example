; Public example only. Never commit the real line number or SIP password.

[transport-odorik-udp]
type=transport
protocol=udp
; Výchozí SIP port. Při změně upravte také SIP_PORT ve firewallovém skriptu.
bind=0.0.0.0:5060

[odorik-registration]
type=registration
transport=transport-odorik-udp
outbound_auth=odorik-auth
server_uri=sip:sip.odorik.cz:6688
client_uri=sip:CHANGE_ME_LINE@sip.odorik.cz
contact_user=CHANGE_ME_LINE
retry_interval=30
forbidden_retry_interval=600
expiration=120
line=yes
endpoint=odorik-inbound

[odorik-auth]
type=auth
auth_type=userpass
username=CHANGE_ME_LINE
password=CHANGE_ME_SIP_PASSWORD

[odorik-aor]
type=aor
contact=sip:sip.odorik.cz:6688
qualify_frequency=60

[odorik-inbound]
type=endpoint
transport=transport-odorik-udp
context=telefonni-adventura-public
disallow=all
allow=alaw,ulaw
aors=odorik-aor
outbound_auth=odorik-auth
direct_media=no
rtp_symmetric=yes
force_rport=yes
rewrite_contact=yes
dtmf_mode=rfc4733
from_domain=sip.odorik.cz

[odorik-primary-identify]
type=identify
endpoint=odorik-inbound
match=81.31.45.51

[odorik-secondary-identify]
type=identify
endpoint=odorik-inbound
match=89.185.255.52
